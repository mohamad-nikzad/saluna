---
import {
  formatPersianTime,
  toPersianDigits,
} from '@repo/salon-core/persian-digits'
import { buildPresenceLinks } from '@repo/salon-core/presence-links'
import {
  isWorkingDayOpen,
  WORKING_DAY_PILLS,
} from '@repo/salon-core/working-days'
import type { PublicSalonView } from '@/lib/public-api'
import { formatDuration, formatPrice } from '@/lib/format'

interface Props {
  view: PublicSalonView
}

const { view } = Astro.props
const { salon, services, publicSettings, presence } = view
const activeServices = services.filter((s) => s.active)
const presenceLinks = buildPresenceLinks(presence)
const mapLinks = presenceLinks.filter((link) => link.kind === 'map')
const contactLinks = presenceLinks.filter((link) => link.kind !== 'map')
const locality = [
  presence.province ? `استان ${presence.province}` : null,
  presence.city ? `شهر ${presence.city}` : null,
  presence.neighborhood ? `محله ${presence.neighborhood}` : null,
]
  .filter(Boolean)
  .join('، ')
const businessHours = view.businessHours
const workingDays = businessHours
  ? WORKING_DAY_PILLS.filter((day) =>
      isWorkingDayOpen(businessHours.workingDays, day.bit),
    )
      .map((day) => day.fullLabel)
      .join('، ')
  : ''
---

<!--
  Crawler-visible shell (salon name, services, contact) stays in the HTML for SEO/JSON-LD
  alignment, but is not shown to users — the React booking island renders the real UI.
-->
<div class="sr-only">
  <header aria-label="اطلاعات سالن">
    <h1>{salon.name}</h1>
    {publicSettings.bioText ? <p>{publicSettings.bioText}</p> : null}
    {
      salon.phone ? (
        <a href={`tel:${salon.phone}`} dir="ltr">
          {toPersianDigits(salon.phone)}
        </a>
      ) : null
    }
    {locality ? <p>{locality}</p> : null}
    {presence.address ? <p>نشانی: {presence.address}</p> : null}
    {
      businessHours && workingDays ? (
        <p>
          روزهای کاری: {workingDays}، ساعت{' '}
          {formatPersianTime(businessHours.workingStart)} تا{' '}
          {formatPersianTime(businessHours.workingEnd)}
        </p>
      ) : null
    }
    {
      mapLinks.length > 0 ? (
        <nav aria-label="لینک‌های نقشه سالن">
          {mapLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </nav>
      ) : null
    }
    {
      contactLinks.length > 0 ? (
        <nav aria-label="لینک‌های ارتباطی سالن">
          {contactLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </nav>
      ) : null
    }
  </header>

  <section aria-label="خدمات سالن">
    <h2>خدمات</h2>
    <ul>
      {
        activeServices.map((service) => (
          <li>
            <h3>{service.name}</h3>
            <p>
              {formatDuration(service.duration)} · {formatPrice(service.price)}
            </p>
            {service.description ? <p>{service.description}</p> : null}
          </li>
        ))
      }
    </ul>
  </section>
</div>
