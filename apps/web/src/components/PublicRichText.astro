---
import { PortableText } from 'emdash/ui'
import type { PortableTextBlock } from 'emdash'
import GuideScreenshot from './GuideScreenshot.astro'
interface Props {
  value?: PortableTextBlock[]
  guide?: boolean
}
const { value, guide = false } = Astro.props
---

<div class:list={['public-prose', { 'guide-prose': guide }]}>
  {
    value && (
      <PortableText
        value={value}
        components={guide ? { type: { image: GuideScreenshot } } : undefined}
      />
    )
  }
</div>

{
  guide && (
    <dialog class="screenshot-dialog" aria-label="بزرگ‌نمایی تصویر">
      <form method="dialog">
        <button class="screenshot-close" autofocus>
          بستن تصویر
        </button>
      </form>
      <img alt="" />
    </dialog>
  )
}

<script>
  const viewer = document.querySelector<HTMLDialogElement>('.screenshot-dialog')
  const fullImage = viewer?.querySelector('img')
  if (viewer && fullImage) {
    document
      .querySelectorAll<HTMLElement>('.guide-screenshot')
      .forEach((figure) => {
        const image = figure.querySelector('img')
        const button =
          figure.querySelector<HTMLButtonElement>('.screenshot-expand')
        if (!image || !button) return
        button.hidden = false
        button.setAttribute('aria-label', `بزرگ‌نمایی تصویر: ${image.alt}`)
        button.addEventListener('click', () => {
          fullImage.src = image.currentSrc || image.src
          fullImage.alt = image.alt
          viewer.showModal()
        })
      })
    viewer.addEventListener('click', (event) => {
      if (event.target === viewer) viewer.close()
    })
  }
</script>

<style is:global>
  .public-prose {
    overflow-wrap: anywhere;
    font-size: 1.0625rem;
    line-height: 2;
    text-align: start;
  }
  .public-prose > * + * {
    margin-block-start: 1.25rem;
  }
  .public-prose h1,
  .public-prose h2,
  .public-prose h3,
  .public-prose h4,
  .public-prose h5,
  .public-prose h6 {
    font-family: inherit;
    font-weight: 700;
    line-height: 1.7;
    margin-block-start: 2.75rem;
    margin-block-end: 0.75rem;
    text-align: start;
    scroll-margin-block-start: 2rem;
  }
  .public-prose h1,
  .public-prose h2 {
    font-size: 1.5rem;
  }
  .public-prose h3 {
    font-size: 1.25rem;
  }
  .public-prose h4,
  .public-prose h5,
  .public-prose h6 {
    font-size: 1.0625rem;
  }
  .public-prose > :first-child {
    margin-block-start: 0;
  }
  .public-prose :is(h1, h2, h3, h4, h5, h6) + * {
    margin-block-start: 0;
  }
  .public-prose ul {
    list-style: disc;
    padding-inline-start: 1.5rem;
  }
  .public-prose ol {
    list-style: decimal;
    padding-inline-start: 1.5rem;
  }
  .public-prose li + li {
    margin-block-start: 0.75rem;
  }
  .public-prose li::marker {
    color: #7a2a40;
    font-weight: 700;
  }
  .public-prose li > * + * {
    margin-block-start: 0.75rem;
  }
  .public-prose a {
    color: #7a2a40;
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }
  .public-prose blockquote {
    border-inline-start: 3px solid #7a2a40;
    padding-inline-start: 1.5rem;
    color: #6b4955;
  }
  .public-prose img,
  .public-prose video,
  .public-prose iframe {
    max-width: 100%;
    height: auto;
    border-radius: 0.75rem;
  }
  .public-prose figcaption {
    color: #6b4955;
    font-size: 0.875rem;
    text-align: center;
    margin-block-start: 0.75rem;
  }
  .guide-prose .guide-screenshot {
    margin-block: 1.5rem 2rem;
  }
  .guide-prose .guide-screenshot figure {
    float: none;
    width: auto;
    max-width: 100%;
    margin: 0;
  }
  .guide-prose .guide-screenshot img {
    display: block;
    width: auto;
    height: auto;
    max-width: min(100%, 32rem);
    max-height: 24rem;
    object-fit: contain;
    object-position: right top;
    border: 1px solid #eadde2;
    border-radius: 0.625rem;
  }
  .guide-prose .guide-screenshot figcaption {
    max-width: 32rem;
    text-align: start;
  }
  .screenshot-expand {
    min-height: 2.75rem;
    margin-block-start: 0.5rem;
    color: #7a2a40;
    font-size: 0.8125rem;
    text-decoration: underline;
    text-underline-offset: 0.25rem;
    cursor: pointer;
  }
  .screenshot-dialog {
    width: fit-content;
    max-width: calc(100vw - 2rem);
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 1rem;
    border: 1px solid #eadde2;
    border-radius: 0.75rem;
    color: #3f2730;
    background: white;
  }
  .screenshot-dialog::backdrop {
    background: rgb(63 39 48 / 70%);
  }
  .screenshot-dialog form {
    position: sticky;
    top: 0;
    background: white;
  }
  .screenshot-dialog img {
    display: block;
    max-width: 100%;
    height: auto;
    margin-block-start: 0.75rem;
  }
  .screenshot-close {
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    background: #fdf5f8;
    border-radius: 0.375rem;
    color: #7a2a40;
    font-size: 0.875rem;
    cursor: pointer;
  }
  .public-prose pre {
    overflow-x: auto;
    direction: ltr;
    padding: 1rem;
    border-radius: 0.75rem;
    background: #f3d5dd;
  }
  .public-prose table {
    display: block;
    overflow-x: auto;
    max-width: 100%;
    border-collapse: collapse;
  }
  .public-prose td,
  .public-prose th {
    padding: 0.75rem;
    border: 1px solid #f3d5dd;
  }
  .public-prose hr {
    border-color: #f3d5dd;
  }
</style>
