---
import { brand } from '@repo/brand'
import { displayClass } from '@/content/landing'
import { publicNavLinks, publicSiteInfo } from '@/content/public-site'
import { featurePages } from '@/content/features'

const brandFa = brand.name.fa
---

<footer class="border-t border-[#f3d5dd] bg-white/60 px-5 py-8 sm:px-8">
  <div
    class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-5 lg:flex-row"
  >
    <div class="flex items-center gap-2.5">
      <img
        src="/landing/saluna-mark-88.webp"
        alt=""
        width="32"
        height="32"
        decoding="async"
        class="h-8 w-8 object-contain"
      />
      <span class={`${displayClass} text-xl text-[#7a2a40]`}>{brandFa}</span>
    </div>

    <nav
      class="flex flex-wrap justify-center gap-x-5 gap-y-2 text-xs text-[#8b6b73]"
    >
      {
        featurePages.map((page) => (
          <a href={page.href} class="transition hover:text-[#7a2a40]">
            {page.linkLabel}
          </a>
        ))
      }
      {
        publicNavLinks.map((link) => (
          <a href={link.href} class="transition hover:text-[#7a2a40]">
            {link.label}
          </a>
        ))
      }
    </nav>

    <div
      class="flex flex-col items-center gap-2 text-xs text-[#8b6b73] sm:flex-row"
    >
      <p>© ۱۴۰۵ {brandFa}. تمام حقوق محفوظ است.</p>
      <span class="hidden sm:inline">|</span>
      <div class="flex items-center gap-1.5">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-3.5 w-3.5"
          aria-hidden="true"
        >
          <path
            d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"
          ></path>
          <path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"></path>
        </svg>
        <span>
          {publicSiteInfo.operatorName}، {publicSiteInfo.location}
        </span>
      </div>
    </div>
  </div>
</footer>
