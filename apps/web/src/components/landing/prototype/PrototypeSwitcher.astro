---
// THROWAWAY: remove after a landing direction is chosen.
---

<div
  dir="ltr"
  class="fixed bottom-4 left-1/2 z-[100] flex -translate-x-1/2 items-center gap-1 rounded-full border border-white/20 bg-[#22171b]/95 p-1.5 text-white shadow-[0_18px_60px_rgba(0,0,0,.35)] backdrop-blur"
  aria-label="تعویض نمونه صفحه فرود"
>
  <button
    type="button"
    data-prototype-step="-1"
    class="grid size-9 place-items-center rounded-full text-lg transition hover:bg-white/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
    aria-label="نمونه قبلی">←</button
  >
  <span data-prototype-label class="min-w-40 px-3 text-center text-xs font-bold"
  ></span>
  <button
    type="button"
    data-prototype-step="1"
    class="grid size-9 place-items-center rounded-full text-lg transition hover:bg-white/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
    aria-label="نمونه بعدی">→</button
  >
</div>

<script>
  const variants = ['current', 'A', 'B', 'C', 'D']
  const labels: Record<string, string> = {
    current: 'نسخه فعلی',
    A: 'A — مسیر درخواست',
    B: 'B — محصول در مرکز',
    C: 'C — روایت سردبیری',
    D: 'D — نسخه فعلی، بهترشده',
  }
  const label = document.querySelector<HTMLElement>('[data-prototype-label]')

  function activeVariant() {
    return document.documentElement.dataset.landingVariant ?? 'A'
  }

  function activate(variant: string) {
    document.documentElement.dataset.landingVariant = variant
    document
      .querySelectorAll<HTMLElement>('[data-prototype-variant]')
      .forEach((page) => {
        page.hidden = page.dataset.prototypeVariant !== variant
      })
    if (label) label.textContent = labels[variant]
    const url = new URL(window.location.href)
    url.searchParams.set('variant', variant)
    history.replaceState({}, '', url)
    window.scrollTo(0, 0)
  }

  function cycle(delta: number) {
    const index = variants.indexOf(activeVariant())
    activate(variants[(index + delta + variants.length) % variants.length])
  }

  document
    .querySelectorAll<HTMLElement>('[data-prototype-step]')
    .forEach((button) => {
      button.addEventListener('click', () =>
        cycle(Number(button.dataset.prototypeStep)),
      )
    })

  document.addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement
    if (
      event.altKey ||
      event.ctrlKey ||
      event.metaKey ||
      ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName) ||
      target.isContentEditable
    )
      return
    if (event.key === 'ArrowLeft') cycle(-1)
    if (event.key === 'ArrowRight') cycle(1)
  })

  const requested = new URL(window.location.href).searchParams.get('variant')
  activate(requested && variants.includes(requested) ? requested : 'D')
</script>
