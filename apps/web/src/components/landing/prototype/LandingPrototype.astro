---
// THROWAWAY UI PROTOTYPE: landing directions, switchable via ?variant=A|B|C|D on `/`.
import { brand } from '@repo/brand'
import { displayClass } from '@/content/landing'
import Icon from '../Icon.astro'
import PrototypeProductCapture from './PrototypeProductCapture.astro'

interface Props {
  loginHref: string
  signupHref: string
}

const { loginHref, signupHref } = Astro.props
const brandFa = brand.name.fa

const workflow = [
  {
    number: '۰۱',
    title: 'درخواست‌ها یک‌جا',
    text: 'درخواست آنلاین، تماس تلفنی یا پیام مشتری را در یک صف نگه دارید.',
  },
  {
    number: '۰۲',
    title: 'بررسی زمان و تخصص',
    text: 'خدمت درخواستی را با برنامه و توانایی پرسنل هماهنگ کنید.',
  },
  {
    number: '۰۳',
    title: 'تأیید و ثبت در تقویم',
    text: 'فقط نوبتی که مدیر تأیید کرده وارد تقویم کاری سالن می‌شود.',
  },
]

const bWorkflow = [
  {
    number: '۰۱',
    title: 'درخواست‌ها یک‌جا',
    text: 'درخواست‌های آنلاین، تلفنی و پیام‌رسانی را یک‌جا ببین.',
  },
  {
    number: '۰۲',
    title: 'وقت و همکار مناسب',
    text: 'زمان خالی و کسی که می‌تواند آن خدمت را انجام دهد پیدا کن.',
  },
  {
    number: '۰۳',
    title: 'نوبت را قطعی کن',
    text: 'وقتی همه‌چیز جور بود، نوبت را تأیید کن تا وارد تقویم شود.',
  },
] as const

const capabilityGroups = [
  {
    eyebrow: 'مشتری',
    title: 'پرونده‌ای که بعد از هر مراجعه کامل‌تر می‌شود',
    text: 'اطلاعات تماس، یادداشت، برچسب، سابقه مراجعه و واردکردن گروهی مشتریان؛ آماده برای پیگیری بعدی.',
    icon: 'users-round',
  },
  {
    eyebrow: 'تیم',
    title: 'برنامه کاری، دسترسی شخصی و کمیسیون در یک مسیر',
    text: 'هر همکار خدمات قابل انجام و ساعت کاری خودش را دارد و گزارش کمیسیونش را جداگانه می‌بیند.',
    icon: 'user-plus',
  },
  {
    eyebrow: 'خدمت',
    title: 'از یک خدمت ساده تا پکیج چندمرحله‌ای',
    text: 'دسته، خدمت، افزودنی و پکیج خدمات را با مدت، قیمت و پرسنل مناسب تعریف کنید.',
    icon: 'scissors',
  },
] as const

const bCapabilityChapters = [
  {
    number: '۰۱',
    eyebrow: 'درخواست‌ها',
    title: 'اول درخواست را ببین، بعد نوبت را قطعی کن',
    text: 'درخواست مشتری هنوز نوبت نیست. اول زمان، خدمت و همکار مناسب را چک کن؛ اگر همه‌چیز جور بود تأییدش کن.',
    items: [
      'درخواست آنلاین از صفحه سالن',
      'یادداشت درخواست‌هایی که با تماس یا پیام می‌رسند',
      'انتخاب چند روز مناسب و ترجیح صبح، بعدازظهر یا عصر',
      'تأیید، رد یا لغو درخواست، بدون پاک‌شدن سابقه',
    ],
  },
  {
    number: '۰۲',
    eyebrow: 'تقویم',
    title: 'برنامه امروز و این هفته همیشه جلوی چشمت است',
    text: 'موقع ثبت نوبت، سالونا ساعت کاری، تخصص همکار و تداخل‌های زمانی را چک می‌کند تا برنامه دوباره به‌هم نریزد.',
    items: [
      'تقویم روز، هفته و ماه، کنار فهرست نوبت‌ها',
      'نمای امروز، صف کار و وضعیت هر نوبت',
      'فیلتر برنامه با همکار یا خدمت',
      'چک ساعت کاری، تخصص و تداخل مشتری یا همکار',
    ],
  },
  {
    number: '۰۳',
    eyebrow: 'مشتری‌ها',
    title: 'مشتری‌ها را با اسم و سابقه‌شان به خاطر بسپار',
    text: 'شماره، یادداشت، برچسب و مراجعه‌های قبلی کنار هم می‌مانند؛ برای پیگیری بعدی لازم نیست بین دفتر و پیام‌ها بگردی.',
    items: [
      'نام، شماره، یادداشت، برچسب و سابقه مراجعه',
      'آوردن چند مشتری باهم از فایل یا مخاطبان گوشی',
      'دیدن شماره‌های تکراری و خطاها قبل از ثبت',
      'نشانه‌های بازگشت مشتری و کارهای پیگیری',
    ],
  },
  {
    number: '۰۴',
    eyebrow: 'تیم و کمیسیون',
    title: 'هر همکار برنامه و حساب خودش را دارد',
    text: 'برنامه و تخصص هرکس را جدا تنظیم کن. هر همکار هم نوبت‌ها و کمیسیون خودش را می‌بیند.',
    items: [
      'پروفایل، تخصص و ساعت کاری هر همکار',
      'دعوت با شماره موبایل و ورود جداگانه',
      'گزارش کمیسیون همه همکارها برای مدیر',
      'صفحه «کمیسیون من» برای هر همکار',
    ],
  },
  {
    number: '۰۵',
    eyebrow: 'خدمات و پکیج‌ها',
    title: 'خدمت ساده یا پکیج چندمرحله‌ای؛ هرکدام با برنامه خودشان',
    text: 'قیمت، مدت و افزودنی‌ها را یک‌بار تعریف کن. برای پکیج هم کارها، زمان و همکار مسئول هر بخش را بچین.',
    items: [
      'دسته، خدمت، قیمت، مدت و افزودنی',
      'خدمات آماده برای راه‌افتادن سریع‌تر',
      'پکیج با کارهای جدا و همکار مسئول هر بخش',
      'اجرای کارهای پکیج در یک روز، با فاصله یا هم‌زمان',
    ],
  },
  {
    number: '۰۶',
    eyebrow: 'گزارش و صفحه سالن',
    title: 'هم امروز را ببین، هم تصویر بزرگ‌تر را',
    text: 'از وضعیت امروز و گزارش ماه تا صفحه عمومی و پیام‌ها، همه‌چیز از داخل سالونا در دسترس است.',
    items: [
      'داشبورد نوبت‌ها، خدمات محبوب و شلوغی کار تیم',
      'مبلغ نوبت‌های انجام‌شده و باقی‌مانده سالن',
      'صفحه سالن با خدمات، آدرس، نقشه و شبکه‌های اجتماعی',
      'اعلان داخل برنامه، پیام‌رسان متصل و کمک برای مدیر',
    ],
  },
] as const
---

<!-- Variant A: warm workflow-first -->
<main
  data-prototype-variant="A"
  dir="rtl"
  class="min-h-dvh overflow-hidden bg-[#f8f2ed] text-[#382b2e]"
>
  <section class="relative isolate overflow-hidden">
    <div
      class="absolute inset-0 -z-20 bg-[radial-gradient(circle_at_15%_5%,#efbdc9_0,transparent_28%),radial-gradient(circle_at_90%_20%,#f6d9c9_0,transparent_30%)]"
    >
    </div>
    <header
      class="mx-auto flex max-w-7xl items-center justify-between px-5 py-5 sm:px-8"
    >
      <a href="#a-top" class="flex items-center gap-2.5" aria-label={brandFa}>
        <img
          src={brand.assets.landingMark}
          alt=""
          class="size-10 object-contain"
        />
        <span class={`${displayClass} text-2xl text-[#742f45]`}>{brandFa}</span>
      </a>
      <nav class="hidden gap-7 text-sm font-bold text-[#735e63] md:flex">
        <a href="#a-flow">مسیر کار</a>
        <a href="#a-capabilities">امکانات</a>
        <a href="#a-start">شروع رایگان</a>
      </nav>
      <a
        href={loginHref}
        class="rounded-full border border-[#cdaeb5] bg-white/60 px-5 py-2 text-sm font-black text-[#742f45]"
        >ورود</a
      >
    </header>
    <div
      id="a-top"
      class="mx-auto grid max-w-7xl gap-12 px-5 pb-24 pt-12 sm:px-8 lg:grid-cols-[.9fr_1.1fr] lg:items-center lg:pb-32 lg:pt-20"
    >
      <div>
        <p
          class="inline-flex items-center gap-2 rounded-full bg-[#742f45] px-4 py-2 text-xs font-black text-white"
        >
          <Icon name="sparkles" class="size-4" />
          مدیریت یکپارچه تقاضای سالن
        </p>
        <h1
          class={`${displayClass} mt-7 max-w-2xl text-5xl leading-[1.12] text-[#47252f] sm:text-7xl`}
        >
          نوبت‌ها، مشتری‌ها و تیم سالن؛
          <span class="text-[#b5425e]"> بدون دفتر و پیام‌های پراکنده</span>
        </h1>
        <p class="mt-7 max-w-xl text-base leading-8 text-[#705d62] sm:text-lg">
          درخواست‌های آنلاین، تلفنی و پیام‌رسان را یک‌جا ثبت کنید، زمان مناسب را
          با برنامه پرسنل هماهنگ کنید و نوبت‌های تأییدشده را وارد تقویم سالن
          کنید.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href={signupHref}
            class="rounded-full bg-[#b5425e] px-7 py-3.5 text-center font-black text-white shadow-[0_18px_45px_rgba(181,66,94,.25)]"
            >ساخت رایگان سالن</a
          >
          <a
            href="#a-flow"
            class="rounded-full border border-[#cdaeb5] bg-white/50 px-7 py-3.5 text-center font-black text-[#742f45]"
            >دیدن مسیر کار</a
          >
        </div>
        <p class="mt-5 text-xs leading-6 text-[#7c676c]">
          نسخه آزمایشی فعلاً رایگانه؛ اگر بعداً پولی شد، قبلش خبر می‌دهیم.
        </p>
      </div>
      <div class="relative lg:translate-y-6">
        <div
          class="absolute -inset-8 -z-10 rotate-3 rounded-[3rem] border border-[#ddbfc5] bg-white/35"
        >
        </div>
        <PrototypeProductCapture
          src="/landing/prototype/today-mobile.jpg"
          alt="نمای واقعی موبایل صفحه امروز سالونا با خلاصه نوبت‌ها، پیش‌نویس درخواست و صف روز"
        />
      </div>
    </div>
  </section>

  <section id="a-flow" class="bg-[#3f252e] px-5 py-20 text-white sm:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="max-w-2xl">
        <p class="text-xs font-black tracking-[.2em] text-[#efacbd]">
          از درخواست تا نوبت قطعی
        </p>
        <h2 class={`${displayClass} mt-4 text-4xl leading-tight sm:text-6xl`}>
          مدیر تصمیم می‌گیرد چه چیزی وارد تقویم شود
        </h2>
      </div>
      <ol
        class="mt-12 grid gap-px overflow-hidden rounded-3xl bg-white/15 lg:grid-cols-3"
      >
        {
          workflow.map((step) => (
            <li class="bg-[#3f252e] p-7 sm:p-9">
              <span class="text-sm font-black text-[#efacbd]">
                {step.number}
              </span>
              <h3 class="mt-10 text-xl font-black">{step.title}</h3>
              <p class="mt-3 text-sm leading-7 text-white/65">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="a-capabilities" class="px-5 py-24 sm:px-8">
    <div class="mx-auto max-w-7xl">
      <p class="text-xs font-black text-[#b5425e]">بعد از ثبت نوبت</p>
      <h2
        class={`${displayClass} mt-3 max-w-3xl text-4xl leading-tight sm:text-6xl`}
      >
        سابقه سالن گم نمی‌شود؛ برای تصمیم بعدی آماده می‌ماند
      </h2>
      <div class="mt-12 grid gap-5 lg:grid-cols-3">
        {
          capabilityGroups.map((item, index) => (
            <article
              class:list={[
                'rounded-[2rem] border border-[#dfcbc7] p-7 sm:p-9',
                index === 1 ? 'bg-[#e9c9cf]' : 'bg-white/60',
              ]}
            >
              <div class="flex items-center justify-between">
                <span class="text-xs font-black text-[#a53b55]">
                  {item.eyebrow}
                </span>
                <Icon name={item.icon} class="size-6 text-[#742f45]" />
              </div>
              <h3 class="mt-16 text-2xl font-black leading-10">{item.title}</h3>
              <p class="mt-4 text-sm leading-7 text-[#705d62]">{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="a-start" class="px-5 pb-28 sm:px-8">
    <div
      class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 rounded-[2rem] bg-[#b5425e] px-7 py-10 text-white sm:px-12 lg:flex-row lg:items-center"
    >
      <div>
        <h2 class={`${displayClass} text-4xl sm:text-5xl`}>
          کارهای اصلی سالن، در یک جریان منظم
        </h2>
        <p class="mt-3 text-sm text-white/75">
          استفاده از نسخه آزمایشی فعلاً رایگان است؛ پیش از شروع پلن‌های پولی
          اطلاع‌رسانی می‌کنیم.
        </p>
      </div>
      <a
        href={signupHref}
        class="shrink-0 rounded-full bg-white px-7 py-3.5 font-black text-[#8b3049]"
        >ساخت رایگان سالن</a
      >
    </div>
  </section>
</main>

<!-- Variant D: current landing, extended and improved -->
<main
  data-prototype-variant="D"
  hidden
  dir="rtl"
  class="min-h-dvh overflow-hidden bg-[#fdf5f8] text-[#3f2730]"
>
  <section class="relative isolate overflow-hidden">
    <img
      src="/landing/hero-bg.webp"
      alt=""
      width="1920"
      height="1080"
      class="absolute inset-0 -z-20 hidden h-full w-full object-cover sm:block"
    />
    <img
      src="/landing/hero-bg-mobile.webp"
      alt=""
      width="750"
      height="1334"
      class="absolute inset-0 -z-20 h-full w-full object-cover sm:hidden"
    />
    <div
      class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgba(253,245,248,.08)_0%,rgba(253,245,248,.72)_58%,#fdf5f8_100%)]"
    >
    </div>

    <header
      class="mx-auto flex w-full max-w-7xl items-center justify-between px-5 py-5 sm:px-8"
    >
      <a href="#d-top" class="flex items-center gap-2.5" aria-label={brandFa}>
        <img
          src={brand.assets.landingMark}
          alt=""
          class="size-10 object-contain sm:size-11"
        />
        <span class={`${displayClass} text-2xl text-[#7a2a40] sm:text-3xl`}>
          {brandFa}
        </span>
      </a>
      <nav class="hidden items-center gap-7 text-sm text-[#6b4955] md:flex">
        <a href="#d-flow">درخواست‌ها</a>
        <a href="#d-features">امکانات</a>
        <a href="#d-product">داخل سالونا</a>
        <a href="#d-faq">پرسش‌ها</a>
      </nav>
      <a
        href={loginHref}
        class="rounded-md border border-[#d68aa0] bg-white/70 px-4 py-2 text-sm font-bold text-[#7a2a40] backdrop-blur"
      >
        ورود
      </a>
    </header>

    <nav
      class="scrollbar-hide mx-auto flex max-w-7xl gap-2 overflow-x-auto px-5 pb-2 text-xs font-bold md:hidden"
      aria-label="دسترسی سریع"
    >
      <a
        href="#d-flow"
        class="shrink-0 rounded-full border border-[#e9b4c2] bg-white/70 px-4 py-2 text-[#7a2a40]"
        >درخواست‌ها</a
      >
      <a
        href="#d-features"
        class="shrink-0 rounded-full border border-[#e9b4c2] bg-white/70 px-4 py-2 text-[#7a2a40]"
        >امکانات</a
      >
      <a
        href="#d-product"
        class="shrink-0 rounded-full border border-[#e9b4c2] bg-white/70 px-4 py-2 text-[#7a2a40]"
        >خودِ محصول</a
      >
    </nav>

    <div
      id="d-top"
      class="mx-auto grid max-w-7xl gap-12 px-5 pb-24 pt-10 sm:px-8 sm:pt-16 lg:grid-cols-[.9fr_1.1fr] lg:items-center"
    >
      <div class="text-center lg:text-right">
        <p
          class="inline-flex items-center gap-2 rounded-full border border-[#e9b4c2] bg-white/75 px-4 py-1.5 text-xs font-bold text-[#7a2a40] backdrop-blur"
        >
          <Icon name="sparkles" class="size-4" />
          کارهای سالن، یک‌جا و مرتب
        </p>
        <h1
          class={`${displayClass} mt-6 text-5xl leading-[1.15] text-[#4a1e2e] sm:text-7xl`}
        >
          نوبت، مشتری و تیم سالن؛
          <span class="text-[#9b2f4a]"> بدون دفتر و پیام‌های گم‌شده</span>
        </h1>
        <p
          class="mx-auto mt-6 max-w-2xl text-base leading-8 text-[#6b4955] lg:mx-0 sm:text-lg"
        >
          درخواست مشتری را از صفحه سالن، تماس یا پیام بگیر. وقت خالی و همکار
          مناسب را پیدا کن و فقط وقتی همه‌چیز جور بود، نوبت را وارد تقویم کن.
        </p>
        <div
          class="mt-8 flex flex-col justify-center gap-3 sm:flex-row lg:justify-start"
        >
          <a
            href={signupHref}
            class="rounded-md bg-[#c3425b] px-7 py-3 text-center font-bold text-white shadow-[0_18px_40px_rgba(124,28,48,.28)]"
          >
            ساخت رایگان سالن
          </a>
          <a
            href="#d-product"
            class="rounded-md border border-[#d68aa0] bg-white/70 px-7 py-3 text-center font-bold text-[#7a2a40] backdrop-blur"
          >
            یه نگاه به سالونا
          </a>
        </div>
        <p class="mt-5 text-xs leading-6 text-[#7a5964]">
          نسخه آزمایشی فعلاً رایگان است؛ اگر قرار باشد پولی شود، قبلش خبرت
          می‌کنیم.
        </p>
      </div>
      <div class="relative mx-auto w-full max-w-xl">
        <div
          class="absolute inset-x-6 bottom-6 top-16 -z-10 rounded-full bg-[#c3425b]/20 blur-3xl"
        >
        </div>
        <PrototypeProductCapture
          src="/landing/prototype/calendar-mobile.jpg"
          alt="تقویم روزانه سالونا با نوبت‌های ثبت‌شده"
        />
      </div>
    </div>
  </section>

  <section id="d-flow" class="px-5 py-20 sm:px-8 sm:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-extrabold text-[#9b3348]">
          از درخواست تا نوبت قطعی
        </p>
        <h2 class={`${displayClass} mt-3 text-4xl leading-tight sm:text-6xl`}>
          تقویم وقتی شلوغ می‌شود که خودت تأیید کرده باشی
        </h2>
        <p class="mt-4 text-base leading-8 text-[#6b4955]">
          درخواست مشتری مستقیم برنامه سالن را به‌هم نمی‌زند؛ اول خودت همه‌چیز را
          چک می‌کنی.
        </p>
      </div>
      <ol class="mt-12 grid gap-4 sm:grid-cols-3">
        {
          bWorkflow.map((step) => (
            <li class="rounded-2xl border border-[#f3d5dd] bg-white/80 p-6 shadow-[0_18px_50px_rgba(155,51,72,.06)]">
              <span class="grid size-10 place-items-center rounded-xl bg-[#fce5ec] text-xs font-extrabold text-[#9b2f4a]">
                {step.number}
              </span>
              <h3 class="mt-8 text-xl font-extrabold">{step.title}</h3>
              <p class="mt-3 text-sm leading-7 text-[#6b4955]">{step.text}</p>
