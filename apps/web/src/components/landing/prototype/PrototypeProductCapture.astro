---
interface Props {
  src: string
  alt: string
  caption?: string
  loading?: 'eager' | 'lazy'
}

const { src, alt, caption, loading = 'lazy' } = Astro.props
---

<figure class="mx-auto w-full max-w-[22rem]">
  <div
    class="relative box-border w-full overflow-hidden rounded-[2.4rem] bg-[#302329] p-[7px] shadow-[0_30px_80px_rgba(46,25,33,.28)]"
  >
    <div class="relative overflow-hidden rounded-[1.95rem] bg-white pt-8">
      <span
        class="absolute left-1/2 top-2 z-10 h-4 w-24 -translate-x-1/2 rounded-full bg-[#302329]"
        aria-hidden="true"></span>
      <img
        src={src}
        alt={alt}
        width="390"
        height="844"
        loading={loading}
        fetchpriority={loading === 'eager' ? 'high' : undefined}
        decoding="async"
        class="block h-auto w-full max-w-full object-cover object-center"
      />
    </div>
  </div>
  {
    caption && (
      <figcaption class="mt-5 text-center text-sm leading-7 text-[#6b4955]">
        {caption}
      </figcaption>
    )
  }
</figure>
