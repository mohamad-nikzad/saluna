---
import { Image } from 'emdash/ui'
import PublicRichText from '../PublicRichText.astro'
import { signupHref } from '@/content/landing'
import type { BlogArticle } from '@/lib/public-content'

interface Props {
  article: BlogArticle
}
const { article } = Astro.props
const publishedDate = article.publishedAt
  ? new Intl.DateTimeFormat('fa-IR', {
      dateStyle: 'long',
      timeZone: 'Asia/Tehran',
    }).format(new Date(article.publishedAt))
  : null
---

<article class="editorial-article">
  <header class="editorial-header">
    <a href="/blog" class="editorial-back">وبلاگ سالونا</a>
    <h1 class="editorial-title">
      {article.title}
    </h1>
    {article.summary && <p class="editorial-summary">{article.summary}</p>}
    <div class="editorial-meta">
      <p>{article.bylines.join('، ')}</p>
      {
        publishedDate && (
          <time datetime={article.publishedAt}>{publishedDate}</time>
        )
      }
    </div>
  </header>
  {
    article.cover && (
      <figure class="editorial-cover">
        <Image
          image={article.cover}
          priority
          placeholder={false}
          class="h-auto w-full"
        />
      </figure>
    )
  }
  <div class="editorial-body">
    <PublicRichText value={article.body} />
  </div>
  <aside class="editorial-cta" aria-label="شروع مدیریت سالن">
    <h2>نوبت‌ها و مشتریان سالن را در سالونا مدیریت کنید</h2>
    <a href={signupHref} class="editorial-button">شروع استفاده از سالونا</a>
  </aside>
</article>
