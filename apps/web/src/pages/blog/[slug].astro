---
export const prerender = false
import BlogArticleLayout from '@/layouts/BlogArticleLayout.astro'
import { readPublicBlogArticle, readBlogPreview } from '@/lib/public-content'
const preview = Astro.url.searchParams.has('_preview')
const article = preview
  ? await readBlogPreview(Astro.params.slug!)
  : await readPublicBlogArticle(Astro.params.slug!)
if (!article) return new Response('مقاله یافت نشد.', { status: 404 })
---

<BlogArticleLayout
  article={article}
  publicOrigin={Astro.site ?? Astro.url.origin}
  preview={preview}
/>
