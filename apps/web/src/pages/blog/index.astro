---
export const prerender = false
import PublicInfoLayout from '@/layouts/PublicInfoLayout.astro'
import ContentIndex from '@/components/ContentIndex.astro'
import { readPublicBlogArticles } from '@/lib/public-content'
import { titleWithBrand } from '@repo/brand'
const entries = await readPublicBlogArticles()
const canonical = new URL('/blog', Astro.site ?? Astro.url.origin).toString()
---

<PublicInfoLayout
  title={titleWithBrand('وبلاگ')}
  description="نوشته‌هایی درباره مدیریت نوبت‌ها، مشتریان و همکاران سالن زیبایی."
  canonical={canonical}
  editorial
>
  <ContentIndex section="blog" entries={entries} />
</PublicInfoLayout>
