---
export const prerender = false
import PublicInfoLayout from '@/layouts/PublicInfoLayout.astro'
import ContentIndex from '@/components/ContentIndex.astro'
import { readPublicGuides } from '@/lib/public-content'
import { titleWithBrand } from '@repo/brand'
const entries = await readPublicGuides()
const canonical = new URL('/guides', Astro.site ?? Astro.url.origin).toString()
---

<PublicInfoLayout
  title={titleWithBrand('راهنماها')}
  description="راهنماهای کاربردی برای انجام کارهای روزانه در سالونا."
  canonical={canonical}
  editorial
>
  <ContentIndex section="guides" entries={entries} />
</PublicInfoLayout>
