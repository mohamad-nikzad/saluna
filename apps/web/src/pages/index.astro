---
export const prerender = true

import Base from '@/layouts/Base.astro'
import LandingPrototype from '@/components/landing/prototype/LandingPrototype.astro'
import { faqItems, loginHref, signupHref } from '@/content/landing'
import { brand } from '@repo/brand'

const title = `نرم‌افزار مدیریت سالن زیبایی و آرایشگاه | ${brand.name.fa}`
const description = `با ${brand.name.fa} نوبت‌ها، مشتریان و برنامه پرسنل سالن را مدیریت کنید، درخواست نوبت آنلاین بگیرید و پورسانت پرسنل را محاسبه کنید. نسخه آزمایشی فعلاً رایگان است.`
const canonical = new URL('/', Astro.url.origin).toString()
const ogImage = new URL('/og/landing.png', canonical).toString()
const ogImageAlt = `${brand.name.fa}؛ نرم‌افزار مدیریت سالن زیبایی و درخواست نوبت با تأیید مدیر`
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: brand.name.fa,
    alternateName: brand.name.en,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    url: canonical,
    inLanguage: 'fa-IR',
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
]
---

<Base
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  jsonLd={jsonLd}
  preloadLalezar={true}
>
  <LandingPrototype loginHref={loginHref} signupHref={signupHref} />
</Base>
