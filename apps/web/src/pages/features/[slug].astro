---
export const prerender = true

import PublicInfoLayout from '@/layouts/PublicInfoLayout.astro'
import { featurePages } from '@/content/features'
import { displayClass, signupHref } from '@/content/landing'
import { toPersianDigits } from '@repo/salon-core/persian-digits'
import { titleWithBrand } from '@repo/brand'

export function getStaticPaths() {
  return featurePages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }))
}

interface Props {
  page: (typeof featurePages)[number]
}
const { page } = Astro.props
const canonical = new URL(page.href, Astro.site ?? Astro.url.origin).toString()
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'سالونا',
      item: new URL('/', canonical).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'امکانات',
      item: new URL('/services', canonical).toString(),
    },
    { '@type': 'ListItem', position: 3, name: page.title, item: canonical },
  ],
}
---

<PublicInfoLayout
  title={titleWithBrand(page.title)}
  description={page.description}
  canonical={canonical}
  jsonLd={jsonLd}
>
  <article class="px-5 py-10 sm:px-8 sm:py-16">
    <div class="mx-auto max-w-6xl">
      <nav
        aria-label="مسیر صفحه"
        class="flex flex-wrap gap-2 text-sm text-[#6b4955]"
      >
        <a href="/" class="underline underline-offset-4">سالونا</a>
        <span aria-hidden="true">/</span>
        <a href="/services" class="underline underline-offset-4">امکانات</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{page.linkLabel}</span>
      </nav>

      <div class="mt-10 grid items-start gap-12 lg:grid-cols-[1.25fr_.75fr]">
        <div>
          <p class="text-sm font-bold text-[#9b3348]">امکانات سالونا</p>
          <h1
            class={`${displayClass} mt-4 text-4xl leading-tight text-[#4a1e2e] sm:text-6xl`}
          >
            {page.title}
          </h1>
          <p class="mt-6 text-base leading-9 text-[#6b4955]">{page.intro}</p>
          <p class="mt-5 border-r-2 border-[#c3425b] pr-4 text-sm leading-8">
            {page.audience}
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a
              href={signupHref}
              class="rounded-md bg-[#c3425b] px-6 py-3 font-bold text-white"
              >شروع استفاده از سالونا</a
            >
            <a
              href="#workflow"
              class="px-2 py-3 font-bold text-[#9b3348] underline underline-offset-4"
              >مراحل کار را ببینید</a
            >
          </div>
        </div>
        <figure class="mx-auto w-full max-w-[22rem]">
          <img
            src={page.screenshot}
            alt={page.screenshotAlt}
            width={page.screenshotWidth}
            height={page.screenshotHeight}
            decoding="async"
            class="h-auto w-full rounded-2xl border border-[#f3d5dd] shadow-[0_20px_60px_rgba(74,30,46,.12)]"
          />
          <figcaption class="mt-4 text-xs leading-6 text-[#6b4955]">
            {page.screenshotCaption}
          </figcaption>
        </figure>
      </div>

      <div
        class="mt-16 grid gap-12 border-t border-[#f3d5dd] pt-12 lg:grid-cols-[1.25fr_.75fr]"
      >
        <section id="workflow" class="scroll-mt-8">
          <h2 class={`${displayClass} text-3xl sm:text-4xl`}>
            مراحل کار در سالونا
          </h2>
          <ol class="mt-8 space-y-8">
            {
              page.steps.map((step, index) => (
                <li class="flex gap-4">
                  <span
                    aria-hidden="true"
                    class="pt-1 text-2xl font-bold text-[#c3425b]"
                  >
                    {toPersianDigits(index + 1)}
                  </span>
                  <div>
                    <>
                      <h3 class="text-lg font-bold">{step.title}</h3>
                      <p class="mt-2 text-sm leading-8 text-[#6b4955]">
                        {step.text}
                      </p>
                    </>
                  </div>
                </li>
              ))
            }
          </ol>
        </section>
        <section class="self-start rounded-2xl bg-[#4a1e2e] p-7 text-white">
          <h2 class="text-xl font-bold leading-9">{page.exampleTitle}</h2>
          <p class="mt-4 text-sm leading-8 text-[#f8e7ec]">{page.example}</p>
        </section>
      </div>

      <section class="mt-14 max-w-3xl">
        <h2 class={`${displayClass} text-3xl sm:text-4xl`}>
          پیش از استفاده بدانید
        </h2>
        <ul
          class="mt-5 list-disc space-y-3 pr-5 text-sm leading-8 text-[#6b4955]"
        >
          {page.limits.map((limit) => <li>{limit}</li>)}
        </ul>
      </section>

      <section class="mt-14 max-w-3xl">
        <h2 class={`${displayClass} text-3xl sm:text-4xl`}>پرسش‌های رایج</h2>
        <div class="mt-5 divide-y divide-[#f3d5dd]">
          {
            page.faq.map((item) => (
              <details class="py-5">
                <>
                  <summary class="cursor-pointer font-bold leading-8">
                    {item.question}
                  </summary>
                  <p class="mt-3 text-sm leading-8 text-[#6b4955]">
                    {item.answer}
                  </p>
                </>
              </details>
            ))
          }
        </div>
      </section>

      <aside
        class="mt-14 border-t border-[#f3d5dd] pt-8"
        aria-label="امکانات مرتبط"
      >
        <h2 class="text-lg font-bold">امکانات مرتبط</h2>
        <ul class="mt-4 flex flex-wrap gap-5 text-sm font-bold text-[#9b3348]">
          {
            featurePages
              .filter((related) => related.slug !== page.slug)
              .map((related) => (
                <li>
                  <a href={related.href} class="underline underline-offset-4">
                    {related.linkLabel}
                  </a>
                </li>
              ))
          }
          <li>
            <a href="/contact" class="underline underline-offset-4"
              >تماس برای راهنمایی و نمایش محصول</a
            >
          </li>
        </ul>
      </aside>
    </div>
  </article>
</PublicInfoLayout>
