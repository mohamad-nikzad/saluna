---
import PublicInfoLayout from './PublicInfoLayout.astro'
import PublicRichText from '../components/PublicRichText.astro'
import { buildGuideMetadata } from '../lib/seo'
import type { ProductGuide } from '../lib/public-content'
import { Image } from 'emdash/ui'
import { guideVideo } from '../lib/guide-video'
interface Props {
  guide: ProductGuide
  publicOrigin: URL | string
  preview?: boolean
}
const { guide, publicOrigin, preview = false } = Astro.props
const reviewed = guide.reviewed_at ? new Date(guide.reviewed_at) : null
const video = guideVideo(guide.video_url)
---

<PublicInfoLayout
  {...buildGuideMetadata(guide, publicOrigin, preview)}
  editorial
>
  {
    preview && (
      <div
        role="status"
        class="bg-[#f3d5dd] px-5 py-3 text-center text-sm font-bold text-[#7a2a40]"
      >
        پیش‌نمایش پیش‌نویس
      </div>
    )
  }
  <article class="editorial-article editorial-guide">
    <header class="editorial-header">
      <a href="/guides" class="editorial-back">راهنماهای سالونا</a>
      <h1 class="editorial-title">
        {guide.title}
      </h1>
      {guide.summary && <p class="editorial-summary">{guide.summary}</p>}
      {
        (reviewed || guide.reviewer_name) && (
          <p class="editorial-meta">
            آخرین بازبینی:{' '}
            {reviewed && (
              <time datetime={reviewed.toISOString()}>
                {new Intl.DateTimeFormat('fa-IR', {
                  dateStyle: 'long',
                  timeZone: 'Asia/Tehran',
                }).format(reviewed)}
              </time>
            )}
            {guide.reviewer_name && <span>{guide.reviewer_name}</span>}
          </p>
        )
      }
    </header>
    {
      guide.cover && (
        <figure class="editorial-cover guide-screenshot">
          <Image
            image={guide.cover}
            priority
            placeholder={false}
            class="h-auto w-full"
          />
          <button
            type="button"
            class="screenshot-expand"
            aria-haspopup="dialog"
            hidden
          >
            بزرگ‌نمایی تصویر
          </button>
        </figure>
      )
    }
    <div class="editorial-body">
      <PublicRichText value={guide.body} guide />
      {
        (video || guide.video_transcript) && (
          <section class="editorial-supplement" aria-label="ویدئو و متن همراه">
            <h2>ویدئو و متن همراه</h2>
            {video?.embed && (
              <iframe
                src={video.embed}
                title={`ویدئو: ${guide.title}`}
                loading="lazy"
                allowfullscreen
                referrerpolicy="strict-origin-when-cross-origin"
                class="mt-6 aspect-video min-h-[200px] w-full rounded-xl border-0"
              />
            )}
            {video?.file && (
              <video
                src={video.href}
                controls
                preload="none"
                class="mt-6 w-full rounded-xl"
              />
            )}
            {video && (
              <a
                href={video.href}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-block text-[#7a2a40] underline underline-offset-4"
              >
                باز کردن ویدئو در سایت میزبان
              </a>
            )}
            {guide.video_transcript && (
              <details class="editorial-transcript">
                <summary>متن همراه ویدئو</summary>
                <p class="whitespace-pre-line">{guide.video_transcript}</p>
              </details>
            )}
          </section>
        )
      }
      {
        guide.relatedGuides.length > 0 && (
          <nav class="editorial-supplement" aria-label="راهنماهای مرتبط">
            <>
              <h2>راهنماهای مرتبط</h2>
              <ul class="mt-5 space-y-3">
                {guide.relatedGuides.map((related) => (
                  <li>
                    <a
                      href={`/guides/${encodeURIComponent(related.slug)}`}
                      class="text-[#7a2a40] underline underline-offset-4"
                    >
                      {related.title}
                    </a>
                  </li>
                ))}
              </ul>
            </>
          </nav>
        )
      }
    </div>
  </article>
</PublicInfoLayout>
