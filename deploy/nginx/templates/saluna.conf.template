map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

map $http_x_forwarded_proto $saluna_forwarded_proto {
  default $http_x_forwarded_proto;
  '' $scheme;
}

# Initial EmDash setup must pass through Arvan's operator-IP firewall guard.
# Source list: https://www.arvancloud.ir/en/ips.txt, checked 2026-10-11.
# Use the TCP peer, never a client-supplied forwarded IP header.
geo $cms_setup_origin_allowed {
  default 0;
  185.143.232.0/22 1;
  188.229.116.16/30 1;
  94.101.182.0/27 1;
  2.144.3.128/28 1;
  37.32.16.0/27 1;
  37.32.17.0/27 1;
  37.32.18.0/27 1;
  37.32.19.0/27 1;
  185.215.232.0/22 1;
  178.131.120.48/28 1;
  94.101.183.0/28 1;
  78.157.36.112/28 1;
  95.38.61.80/28 1;
  193.24.119.0/29 1;
}

map $uri $cms_setup_write {
  default 0;
  ~^/_emdash/api/(setup|auth/oauth)(/|$) 1;
  /_emdash/api/setup/status 0;
}

map "$cms_setup_write:$cms_setup_origin_allowed" $cms_setup_origin_denied {
  default 0;
  "1:0" 1;
}

server {
  listen 80 default_server;
  server_name _;

  location = /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "ok\n";
  }

  location / {
    return 404;
  }
}

server {
  listen 443 ssl default_server;
  server_name _;

  ssl_certificate /etc/nginx/certs/saluna-origin.crt;
  ssl_certificate_key /etc/nginx/certs/saluna-origin.key;
  ssl_protocols TLSv1.2 TLSv1.3;

  location = /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "ok\n";
  }

  location / {
    return 404;
  }
}

server {
  listen 80;
  listen 443 ssl;
  server_name www.${PUBLIC_DOMAIN};

  ssl_certificate /etc/nginx/certs/saluna-origin.crt;
  ssl_certificate_key /etc/nginx/certs/saluna-origin.key;
  ssl_protocols TLSv1.2 TLSv1.3;

  return 308 https://${PUBLIC_DOMAIN}$request_uri;
}

server {
  listen 80;
  server_name ${PUBLIC_DOMAIN};

  if ($cms_setup_origin_denied) { return 403; }

  client_max_body_size 5m;

  location = /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "ok\n";
  }

  location / {
    proxy_pass http://web:3001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $saluna_forwarded_proto;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}

server {
  listen 443 ssl;
  server_name ${PUBLIC_DOMAIN};

  if ($cms_setup_origin_denied) { return 403; }

  ssl_certificate /etc/nginx/certs/saluna-origin.crt;
