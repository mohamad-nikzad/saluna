# New staging hosts only. Loaded alongside the existing production routing.
server {
  listen 80;
  listen 443 ssl;
  server_name staging.saluna.ir staging-app.saluna.ir staging-api.saluna.ir;
  ssl_certificate /etc/nginx/certs/saluna-origin.crt;
  ssl_certificate_key /etc/nginx/certs/saluna-origin.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  client_max_body_size 5m;
  proxy_connect_timeout 2s;
  resolver 127.0.0.11 valid=10s;
  resolver_timeout 2s;
  auth_basic "Saluna QA";
  auth_basic_user_file /etc/nginx/templates/saluna-qa.htpasswd;
  add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
  add_header Cache-Control "no-store" always;

  location = /robots.txt {
    auth_basic off;
    return 200 "User-agent: *\nDisallow: /\n";
  }
  location ~ ^/_qa/(status|wake|sleep)$ {
    set $qa_control http://saluna-qa-control-control-1:8086;
    proxy_pass $qa_control;
    proxy_set_header Host $host;
    proxy_set_header Authorization "";
    proxy_read_timeout 120s;
  }
  location / {
    set $qa_gateway http://saluna-qa-gateway-1:8080;
    proxy_pass $qa_gateway;
    proxy_set_header Host $host;
    proxy_set_header Authorization "";
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 30s;
    proxy_intercept_errors on;
    error_page 502 504 =503 @qa_asleep;
  }
  location @qa_asleep {
    default_type text/plain;
    return 503 "Saluna QA is asleep or unavailable. Request a QA session to wake it.\n";
  }
}
