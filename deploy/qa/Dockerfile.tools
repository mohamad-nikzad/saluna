ARG QA_BUILD_IMAGE=saluna-qa-api-build:local
FROM ${QA_BUILD_IMAGE} AS build
COPY scripts/db-seed.ts scripts/qa-seed.ts ./scripts/
RUN pnpm exec esbuild scripts/qa-seed.ts --tsconfig=apps/api/tsconfig.json --bundle --platform=node --target=node22 --format=cjs --outfile=/app/qa-seed.cjs --log-level=warning

FROM node:22.12.0-alpine
WORKDIR /app
COPY --from=build /app/qa-seed.cjs ./qa-seed.cjs
COPY --from=build /app/apps/api/dist/migrate.cjs ./migrate.cjs
COPY --from=build /app/packages/database/src/migrations ./migrations
ENV SALUNA_MIGRATIONS_DIR=/app/migrations
USER node
ENTRYPOINT ["node"]
